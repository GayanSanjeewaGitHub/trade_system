# ===================================
# Trading Chatbot Configuration
# ===================================

# Application Settings
APP_NAME=TradingChatbot
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=False

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=trading-chatbot-index
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=True

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
EMBEDDING_MODEL=text-embedding-3-small

# Guardrails Configuration
MAX_TRADE_AMOUNT=100000.0
MIN_TRADE_AMOUNT=1.0
MAX_MESSAGE_LENGTH=5000

# Agent Configuration
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT=120
MAX_TOOL_RETRIES=3

# Intent Classification Keywords
# Customize these comma-separated keywords to control agent routing
# ADVISOR_KEYWORDS: Keywords that trigger routing to the Advisor Agent for trading-related queries
ADVISOR_KEYWORDS=buy,sell,trade,stock,price,invest,portfolio,shares,market,dividend,broker

# FAQ_KEYWORDS: Keywords that trigger routing to the FAQ Agent for general information queries
# Based on topics in data folder: accounts, policies, regulations, fees, trading operations, etc.
FAQ_KEYWORDS=account,cds,fee,charge,policy,regulation,sec,cse,hours,contact,support,ipo,listing,open account,how to,what is,transfer,withdraw,deposit,statement

# MCP Configuration
MCP_SERVER_URL=http://localhost:8001
MCP_TIMEOUT=30
MCP_ENABLED=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60000
RATE_LIMIT_PER_HOUR=100000

# Session Management
SESSION_TIMEOUT=36000
MAX_CONVERSATION_HISTORY=500

# Monitoring & Evaluation
ENABLE_AUTO_EVAL=True
EVAL_SAMPLE_RATE=0.1
METRICS_RETENTION_DAYS=30

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
CACHE_TTL=3600

# Document Processing
MAX_FILE_SIZE=10485760
TEMP_UPLOAD_DIR=/tmp/uploads

# Logging
LOG_FORMAT=json
# LOG_FILE=
LOG_ROTATION=1 day
LOG_RETENTION=30 days
