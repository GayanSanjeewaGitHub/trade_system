# Application Configuration
APP_NAME=TradingChatbot
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=production
DEBUG=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
EMBEDDING_MODEL="text-embedding-3-small"

# Guardrails Configuration
MAX_TRADE_AMOUNT=100000.0
MIN_TRADE_AMOUNT=1.0
MAX_MESSAGE_LENGTH=5000
RESTRICTED_TOPICS=["politics", "religion"]
PROFANITY_THRESHOLD=0.8

# Agent Configuration
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT=120
MAX_TOOL_RETRIES=3

# MCP Configuration
MCP_SERVER_URL=http://localhost:8001
MCP_TIMEOUT=30
MCP_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Session Management
SESSION_TIMEOUT=3600
MAX_CONVERSATION_HISTORY=50

# Monitoring
ENABLE_AUTO_EVAL=true
EVAL_SAMPLE_RATE=0.1
METRICS_RETENTION_DAYS=30

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600

# Document Processing
MAX_FILE_SIZE=10485760
TEMP_UPLOAD_DIR=/tmp/uploads

